@echo off
chcp 65001 >nul
cd /d "%~dp0"
title 多普勒 一键连接（桥接 + 模拟器端口映射）

echo ============================================================
echo  串口桥接 + adb 端口映射，一个进程管两件事。
echo  这个窗口不要关。App 里点"网络桥"就能连。
echo ============================================================
echo.
python -u serial_bridge.py --port auto --listen 7878 --adb
echo.
echo 桥接已退出（退出码 %ERRORLEVEL%）
echo.
echo 如果 App 还是"连不上 127.0.0.1:7878"，按上面日志里的提示对号入座：
echo   没找到串口   - 电台没插 / 线是充电线 / 驱动没装
echo   端口被占用   - 关掉多普勒工具、另一个桥接窗口、串口助手
echo   隧道：无设备 - 先打开 MuMu 进桌面，再重跑本文件
pause
